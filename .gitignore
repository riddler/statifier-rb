# Changelog fragments are tracked. A global gitignore rule for `*.d` (C/C++
# dependency files) matches this directory name and would otherwise hide them.
!changelog.d/

# Local beads telemetry churn; the tracker syncs through its own Dolt remote
# (`sync.remote` in `.beads/config.yaml`), not through this git repository.
.beads/interactions.jsonl
